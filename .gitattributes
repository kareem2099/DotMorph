# Normalise line endings in text files
* text=auto eol=lf

# Binary assets: never diff or merge them as text
*.png  binary
*.gif  binary
*.jpg  binary
*.webp binary
*.ico  binary

# Generated by packaging/build.py assets: collapse them in diffs, keep them out of language stats
packaging/linux/**  linguist-generated=true
packaging/linux/icons/*.png  binary

# QML is part of the app, not documentation
*.qml  linguist-language=QML
docs/** linguist-documentation=true

# GitHub's "Source code" tarball: leave out what isn't needed to build
.github/** export-ignore
